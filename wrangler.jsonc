// Configuração do Cloudflare (Workers com arquivos estáticos)
{
  "name": "federacaopetenis",
  "compatibility_date": "2025-06-01",
  // Publica no endereço gratuito *.workers.dev
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Rotas como /torneios/123 abrem o app (SPA)
    "not_found_handling": "single-page-application"
  }
}
